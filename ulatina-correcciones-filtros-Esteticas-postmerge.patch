       u.nombre_completo AS nombre_tecnico,u.correo_institucional AS correo_tecnico,l.id_laboratorio,l.codigo AS codigo_laboratorio,l.nombre AS nombre_laboratorio,s.id_sede,s.nombre AS nombre_sede
