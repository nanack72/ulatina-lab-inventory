+      <label htmlFor={id + '-lab'}>
+        Laboratorio
+        <select
+          id={id + '-lab'}
+          name="laboratorio"
+          value={laboratorio}
+          onChange={(e) => alCambiar(sede, e.target.value)}
+        >
+          <option value="">Todos los laboratorios</option>
+          {opciones.laboratorios.map((l) => (
