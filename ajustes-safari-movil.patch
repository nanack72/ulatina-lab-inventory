diff --git a/frontend/src/styles/login.css b/frontend/src/styles/login.css
--- a/frontend/src/styles/login.css
+++ b/frontend/src/styles/login.css
@@ -730,3 +730,36 @@
     transition-duration: 0.01ms !important;
   }
 }
+
+/* Safari móvil: fondo continuo, zonas seguras y controles sin zoom automático. */
+@media (max-width: 720px) {
+  html:has(.login-page),
+  body:has(.login-page) {
+    background: #075640;
+  }
+
+  .login-page {
+    min-height: 100dvh;
+    padding-top: max(20px, env(safe-area-inset-top));
+    padding-bottom: max(20px, env(safe-area-inset-bottom));
+    padding-left: max(20px, env(safe-area-inset-left));
+    padding-right: max(20px, env(safe-area-inset-right));
+  }
+
+  .login-page .login-input-wrapper input {
+    font-size: max(1rem, 16px);
+  }
+
+  .login-page .login-options { flex-wrap: wrap; }
+}
+
+@media (pointer: coarse) {
+  .login-page .login-input-wrapper input { font-size: max(1rem, 16px); }
+}
+
+@media (max-width: 390px) {
+  .login-page {
+    padding-left: max(12px, env(safe-area-inset-left));
+    padding-right: max(12px, env(safe-area-inset-right));
+  }
+}
diff --git a/frontend/src/styles/tablasMovil.css b/frontend/src/styles/tablasMovil.css
--- a/frontend/src/styles/tablasMovil.css
+++ b/frontend/src/styles/tablasMovil.css
@@ -160,3 +160,20 @@
     padding: 14px;
   }
 }
+
+@media (max-width: 700px) {
+  /* Los nombres pueden ser largos: evitar una media fila vacía a su derecha. */
+  .main-page .mod-tabla td[data-label="Reportado por"] {
+    grid-column: 1 / -1;
+  }
+
+  /* En pantallas táctiles Safari puede conservar :hover tras tocar un selector.
+     El color debe ser uniforme, incluidas las zonas vacías de la cuadrícula. */
+  .main-page .inv-tabla tbody tr:hover td {
+    background: transparent;
+  }
+  .main-page .inv-tabla tbody tr:hover td:first-child,
+  .main-page .inv-tabla tbody tr:focus-within td:first-child {
+    border-left: 0;
+  }
+}
