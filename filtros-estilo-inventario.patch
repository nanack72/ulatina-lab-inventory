+export default function FiltrosUbicacion({ token, valor, onChange, disabled = false, compacto = false }) {
   const id = useId();
   const cargar = useCallback(signal => obtenerUbicaciones(token, signal), [token]);
   const { datos, cargando, error } = useListadoModulo(cargar);
   const laboratorios = (datos?.laboratorios || []).filter(l => !valor.sede || String(l.id_sede) === valor.sede);
+  if (compacto) return <>
+    <Aviso error>{error}</Aviso>
+    <FiltroSelect etiqueta="Sede" valor={valor.sede} disabled={disabled || cargando || !!error}
+      opciones={(datos?.sedes || []).map(s => ({ valor: String(s.id_sede), texto: s.nombre }))}
+      onChange={sede => onChange({ sede, laboratorio: '' })} />
+    <FiltroSelect etiqueta="Laboratorio" valor={valor.laboratorio} disabled={disabled || cargando || !!error}
+      opciones={laboratorios.map(l => ({ valor: String(l.id_laboratorio), texto: l.nombre }))}
+      onChange={laboratorio => onChange({ ...valor, laboratorio })} />
+  </>;
   return <>
     <Aviso error>{error}</Aviso>
     <label className="mod-campo" htmlFor={id + '-sede'}>Sede
